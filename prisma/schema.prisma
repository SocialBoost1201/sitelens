// SiteLens — Prisma Schema
// Source of truth for ORM types. DDL is managed by Supabase migrations.
// After any Supabase migration, run:  npx prisma generate
// Do NOT run `prisma migrate dev` — use the Supabase migration system for DDL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Datasource URL is resolved at CLI time by prisma.config.ts (DIRECT_URL → DATABASE_URL).
// At runtime, PrismaClient reads DATABASE_URL via the pg adapter in src/lib/db/client.ts.
datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════════════════════

enum AuditStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum FindingSeverity {
  CRITICAL
  WARNING
  INFO
  PASSED
}

// Device targeting for keyword rank tracking (Doc-11 / BL-01).
enum RankDevice {
  DESKTOP
  MOBILE
}

enum FindingCategory {
  PERFORMANCE
  ACCESSIBILITY
  BEST_PRACTICES
  SEO
  STRUCTURED_DATA
}

enum FindingStatus {
  NEW
  RECURRING
  RESOLVED
}

enum AlertOperator {
  BELOW
  ABOVE
}

enum ProjectRole {
  ANALYST
  VIEWER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum NotificationChannelType {
  SLACK
  DISCORD
  EMAIL
}

enum NotificationEvent {
  AUDIT_COMPLETE
  AUDIT_FAILED
  SCORE_DROP
  BROKEN_LINKS_FOUND
  SECURITY_GRADE_DROP
}

enum UptimeStatus {
  UP
  DOWN
  DEGRADED
}

// ═══════════════════════════════════════════════════════════════════════════════
// CORE — Project & Audit pipeline
// ═══════════════════════════════════════════════════════════════════════════════

model Project {
  id        String   @id @default(cuid())
  url       String
  name      String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditRuns            AuditRun[]
  alertRules           AlertRule[]
  members              ProjectMember[]
  pages                PageUrl[]
  comments             Comment[]
  notificationChannels NotificationChannel[]
  publicShares         PublicShare[]
  invites              ProjectInvite[]
  brokenLinks          BrokenLink[]
  animationResults     AnimationResult[]
  seoResults           SeoResult[]
  securityResults      SecurityResult[]
  uptimeMonitors       UptimeMonitor[]
  trackedKeywords      TrackedKeyword[]

  @@index([userId])
}

model AuditRun {
  id           String      @id @default(cuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status       AuditStatus @default(PENDING)
  startedAt    DateTime?
  finishedAt   DateTime?
  errorMessage String?
  rawData      Json?
  createdAt    DateTime    @default(now())

  metrics    Metric[]
  findings   Finding[]
  violations AlertViolation[]
  pageUrls   PageUrl[]
  comments   Comment[]

  @@index([projectId])
  @@index([status])
}

model Metric {
  id         String   @id @default(cuid())
  auditRunId String
  auditRun   AuditRun @relation(fields: [auditRunId], references: [id], onDelete: Cascade)
  key        String
  value      Float
  unit       String?
  source     String
  createdAt  DateTime @default(now())

  @@index([auditRunId])
  @@index([key, source])
}

model Finding {
  id           String          @id @default(cuid())
  auditRunId   String
  auditRun     AuditRun        @relation(fields: [auditRunId], references: [id], onDelete: Cascade)
  key          String
  title        String
  severity     FindingSeverity
  category     FindingCategory
  source       String
  status       FindingStatus?
  displayValue String?
  createdAt    DateTime        @default(now())

  @@index([auditRunId])
  @@index([auditRunId, severity])
  @@index([auditRunId, category])
}

// ═══════════════════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════════════════

model AlertRule {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  metric    String
  operator  AlertOperator @default(BELOW)
  threshold Float
  enabled   Boolean       @default(true)
  createdAt DateTime      @default(now())

  violations AlertViolation[]

  @@index([projectId])
}

model AlertViolation {
  id          String        @id @default(cuid())
  auditRunId  String
  auditRun    AuditRun      @relation(fields: [auditRunId], references: [id], onDelete: Cascade)
  alertRuleId String
  alertRule   AlertRule     @relation(fields: [alertRuleId], references: [id], onDelete: Cascade)
  metricKey   String
  actualValue Float
  threshold   Float
  operator    AlertOperator
  createdAt   DateTime      @default(now())

  @@index([auditRunId])
  @@index([alertRuleId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// TEAM / ACCESS
// ═══════════════════════════════════════════════════════════════════════════════

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  role      ProjectRole
  invitedBy String
  createdAt DateTime    @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectInvite {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  email     String
  role      ProjectRole  @default(VIEWER)
  invitedBy String
  token     String
  status    InviteStatus @default(PENDING)
  expiresAt DateTime     @default(now())
  createdAt DateTime     @default(now())

  @@index([projectId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// CONTENT / COLLABORATION
// ═══════════════════════════════════════════════════════════════════════════════

model Comment {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId   String
  content    String
  auditRunId String?
  auditRun   AuditRun? @relation(fields: [auditRunId], references: [id], onDelete: SetNull)
  findingKey String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([projectId])
  @@index([auditRunId])
}

model PageUrl {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url            String
  discoveredAt   DateTime  @default(now())
  lastAuditedAt  DateTime?
  lastAuditRunId String?
  lastAuditRun   AuditRun? @relation(fields: [lastAuditRunId], references: [id], onDelete: SetNull)

  @@unique([projectId, url])
  @@index([projectId])
}

model PublicShare {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  slug      String    @unique
  enabled   Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([projectId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// NOTIFICATIONS
// ═══════════════════════════════════════════════════════════════════════════════

model NotificationChannel {
  id           String                  @id @default(cuid())
  projectId    String
  project      Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String                  @default("")
  type         NotificationChannelType
  url          String
  events       NotificationEvent[]
  enabled      Boolean                 @default(true)
  lastTestedAt DateTime?
  createdAt    DateTime                @default(now())

  @@index([projectId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// SPECIALISED ANALYSIS RESULTS
// ═══════════════════════════════════════════════════════════════════════════════

model AnimationResult {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url           String
  analyzedAt    DateTime @default(now())
  totalCount    Int      @default(0)
  gpuComposited Int      @default(0)
  nonComposited Int      @default(0)
  loopCount     Int      @default(0)
  reducedMotion Boolean  @default(false)
  clsRisk       Boolean  @default(false)
  data          Json     @default("{}")

  @@index([projectId])
  @@index([projectId, analyzedAt])
}

model BrokenLink {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pageUrl   String
  linkUrl   String
  statusCode Int?
  error     String?
  checkedAt DateTime @default(now())

  @@index([projectId])
}

model SeoResult {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url        String
  score      Float?
  data       Json     @default("{}")
  analyzedAt DateTime @default(now())

  @@index([projectId])
}

model SecurityResult {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  score     Float?
  grade     String?
  data      Json     @default("{}")
  scannedAt DateTime @default(now())

  @@index([projectId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// UPTIME MONITORING
// ═══════════════════════════════════════════════════════════════════════════════

model UptimeMonitor {
  id            String       @id @default(cuid())
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url           String
  enabled       Boolean      @default(true)
  intervalMin   Int          @default(5)
  lastCheckedAt DateTime?
  lastLatencyMs Int?
  lastStatus    UptimeStatus?
  createdAt     DateTime     @default(now())

  events UptimeEvent[]

  @@index([projectId])
}

model UptimeEvent {
  id        String       @id @default(cuid())
  monitorId String
  monitor   UptimeMonitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  status    UptimeStatus
  statusCode Int?
  latencyMs  Int?
  error      String?
  checkedAt  DateTime    @default(now())

  @@index([monitorId])
}

// ═══ KEYWORD & RANK TRACKING (Doc-11 / BL-01) ═══
// New axis: config-entity + history, mirrors UptimeMonitor + UptimeEvent.
// No 0–100 score (approval-gated).

model TrackedKeyword {
  id            String      @id @default(cuid())
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  keyword       String
  targetUrl     String
  country       String      @default("us")
  language      String      @default("en")
  device        RankDevice  @default(DESKTOP)
  enabled       Boolean     @default(true)
  lastCheckedAt DateTime?
  lastPosition  Int?
  createdAt     DateTime    @default(now())

  snapshots KeywordRankSnapshot[]

  @@unique([projectId, keyword, country, language, device])
  @@index([projectId])
}

model KeywordRankSnapshot {
  id           String         @id @default(cuid())
  keywordId    String
  keyword      TrackedKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  position     Int?
  rankedUrl    String?
  serpFeatures Json           @default("{}")
  source       String
  capturedAt   DateTime       @default(now())

  @@index([keywordId])
  @@index([keywordId, capturedAt])
}

// ═══════════════════════════════════════════════════════════════════════════════
// GOOGLE BUSINESS PROFILE
// ═══════════════════════════════════════════════════════════════════════════════

model GoogleIntegration {
  id           String    @id @default(cuid())
  userId       String
  accessToken  String
  refreshToken String?
  expiryDate   DateTime?
  createdAt    DateTime  @default(now())

  locations GbpLocation[]

  @@index([userId])
}

model GbpLocation {
  id                  String            @id @default(cuid())
  googleIntegrationId String
  googleIntegration   GoogleIntegration @relation(fields: [googleIntegrationId], references: [id], onDelete: Cascade)
  googleLocationId    String            @unique
  title               String
  createdAt           DateTime          @default(now())

  dailyMetrics GbpDailyMetric[]

  @@index([googleIntegrationId])
}

model GbpDailyMetric {
  id            String      @id @default(cuid())
  gbpLocationId String
  gbpLocation   GbpLocation @relation(fields: [gbpLocationId], references: [id], onDelete: Cascade)
  metricDate    DateTime
  metricName    String
  metricValue   Int
  createdAt     DateTime    @default(now())

  @@unique([gbpLocationId, metricDate, metricName])
  @@index([gbpLocationId, metricDate])
}
