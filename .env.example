# Environment Variables — SiteLens
# Copy this file to .env.local and fill in actual values.
# NEVER commit .env.local to version control.

# ─── Application ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Found in: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Database (Prisma + Supabase Postgres) ────────────────────────────────────
# DATABASE_URL: pooled connection string (via Supabase pgBouncer, port 6543)
# DIRECT_URL:   direct connection string (port 5432) — used by Prisma migrations
# Found in: Supabase dashboard → Project Settings → Database → Connection string
DATABASE_URL=
DIRECT_URL=

# ─── Product Analytics — PostHog ──────────────────────────────────────────────
# Found in: PostHog dashboard → Project Settings → Project API Key
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Cache / Rate Limiting — Upstash Redis ───────────────────────────────────
# Found in: Upstash console → Database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Google APIs ──────────────────────────────────────────────────────────────
# PageSpeed Insights API key (Google Cloud Console → APIs & Services → Credentials)
PAGESPEED_API_KEY=
# Search Console service account (Google Cloud Console → IAM → Service Accounts)
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=
# Google Business Profile OAuth app (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Encrypts stored GBP OAuth tokens at rest (AES-256-GCM). 32-byte key as 64-char
# hex or base64. Generate: openssl rand -hex 32
GBP_TOKEN_ENC_KEY=

# ─── Email — Resend ───────────────────────────────────────────────────────────
# API key for sending transactional emails via Resend
# Get from: https://resend.com/api-keys
RESEND_API_KEY=
# Sender address shown in outgoing emails (optional — defaults to a Resend shared domain)
EMAIL_FROM="SiteLens <noreply@sitelens.app>"

# ─── GitHub Integration ───────────────────────────────────────────────────────
# Personal access token used to post comments on commits and pull requests
# Get from: https://github.com/settings/tokens (scopes: repo)
GITHUB_TOKEN=
# Secret used to verify the signature of incoming GitHub webhook payloads
# Set this when registering the webhook at: GitHub repo → Settings → Webhooks
GITHUB_WEBHOOK_SECRET=

# ─── Vercel Integration ───────────────────────────────────────────────────────
# Secret used to verify the signature of incoming Vercel webhook payloads
# Set this when registering the webhook at: https://vercel.com/account/webhooks
VERCEL_WEBHOOK_SECRET=

# ─── Keyword Rank Tracking — DataForSEO ──────────────────────────────────────
# DataForSEO Basic Auth credentials (https://dataforseo.com → Account → API Access)
# Required for /api/cron/rank-fetch and the manual refresh endpoint.
# If unset, rank fetch throws a clear error — no silent failure.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Optional — change rank provider (default: dataforseo). Only "dataforseo" is implemented at MVP.
# RANK_PROVIDER=dataforseo

# ─── Scheduled Jobs ───────────────────────────────────────────────────────────
# Shared secret for the /api/cron/* endpoints — use a long random string
# Generate: openssl rand -hex 32
CRON_SECRET=
